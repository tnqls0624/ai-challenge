  "info": {
    "title": "돈워리 API",
    "description": "고령자 금융 안전 공동대응 MVP API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "deviceCredential": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {
      "ServiceMetadataDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "dont-worry-api"
          },
          "status": {
            "type": "string",
            "example": "ok"
          },
          "riskEngineVersion": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": [
          "name",
          "status",
          "riskEngineVersion"
        ]
      },
      "CreateGuardianSessionRequestDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "김보호"
          }
        },
        "required": [
          "displayName"
        ]
      },
      "GuardianSessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "example": "김보호"
          },
          "email": {
            "type": "object",
            "example": "guardian@example.com",
            "nullable": true
          }
        },
        "required": [
          "id",
          "displayName",
          "email"
        ]
      },
      "CreateSubjectRequestDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "어머니"
          },
          "role": {
            "type": "string",
            "enum": [
              "CARE_WORKER",
              "WELFARE_STAFF",
              "RELATIVE",
              "NEIGHBOR",
              "CHILD"
            ],
            "example": "CHILD"
          }
        },
        "required": [
          "displayName",
          "role"
        ]
      },
      "SubjectResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "example": "어머니"
          },
          "careConnectionId": {
            "type": "string",
            "format": "uuid"
          },
          "careConnectionStatus": {
            "type": "string",
            "enum": [
              "PENDING_CONSENT",
              "ACTIVE",
              "REVOKED"
            ]
          },
          "version": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "id",
          "displayName",
          "careConnectionId",
          "careConnectionStatus",
          "version"
        ]
      },
      "ActivationCodeResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "응답에서 한 번만 제공되는 6자리 활성화 코드",
            "example": "123456"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "expiresAt"
        ]
      },
      "ActivationPreviewRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "123456",
            "pattern": "^\\d{6}$"
          },
          "deviceInstallationId": {
            "type": "string",
            "example": "4d90589b-6840-4cb2-a02e-ace1b33bf42e"
          }
        },
        "required": [
          "code",
          "deviceInstallationId"
        ]
      },
      "ActivationConsentTextVersionsDto": {
        "type": "object",
        "properties": {
          "careConnection": {
            "type": "string",
            "example": "care-connection-v1"
          },
          "autoGuardianAlert": {
            "type": "string",
            "example": "auto-guardian-alert-v1"
          }
        },
        "required": [
          "careConnection",
          "autoGuardianAlert"
        ]
      },
      "ActivationPreviewResponseDto": {
        "type": "object",
        "properties": {
          "activationSessionId": {
            "type": "string",
            "description": "한 번만 제공되는 opaque activation session token"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "subjectDisplayName": {
            "type": "string",
            "example": "어머니"
          },
          "guardianDisplayName": {
            "type": "string",
            "example": "김보호"
          },
          "relationshipRole": {
            "type": "string",
            "enum": [
              "CARE_WORKER",
              "WELFARE_STAFF",
              "RELATIVE",
              "NEIGHBOR",
              "CHILD"
            ]
          },
          "consentTextVersions": {
            "$ref": "#/components/schemas/ActivationConsentTextVersionsDto"
          }
        },
        "required": [
          "activationSessionId",
          "expiresAt",
          "subjectDisplayName",
          "guardianDisplayName",
          "relationshipRole",
          "consentTextVersions"
        ]
      },
      "CareConnectionConsentDto": {
        "type": "object",
        "properties": {
          "granted": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          },
          "consentTextVersion": {
            "type": "string",
            "example": "care-connection-v1"
          }
        },
        "required": [
          "granted",
          "consentTextVersion"
        ]
      },
      "AutoGuardianAlertConsentDto": {
        "type": "object",
        "properties": {
          "granted": {
            "type": "boolean"
          },
          "threshold": {
            "type": "string",
            "enum": [
              "NONE",
              "HIGH",
              "CRITICAL"
            ]
          },
          "consentTextVersion": {
            "type": "string",
            "example": "auto-guardian-alert-v1"
          }
        },
        "required": [
          "granted",
          "threshold",
          "consentTextVersion"
        ]
      },
      "ActivationFinalizeRequestDto": {
        "type": "object",
        "properties": {
          "activationSessionId": {
            "type": "string",
            "description": "preview 응답의 opaque session token"
          },
          "deviceInstallationId": {
            "type": "string",
            "description": "preview 요청에 사용한 기기 설치 ID"
          },
          "devicePublicKey": {
            "type": "string",
            "description": "Android Keystore 공개키",
            "minLength": 32
          },
          "shareLevel": {
            "type": "string",
            "enum": [
              "MINIMAL",
              "BASIC"
            ]
          },
          "careConnectionConsent": {
            "$ref": "#/components/schemas/CareConnectionConsentDto"
          },
          "autoGuardianAlertConsent": {
            "$ref": "#/components/schemas/AutoGuardianAlertConsentDto"
          }
        },
        "required": [
          "activationSessionId",
          "deviceInstallationId",
          "devicePublicKey",
          "shareLevel",
          "careConnectionConsent",
          "autoGuardianAlertConsent"
        ]
      },
      "ActivationResponseDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "deviceCredential": {
            "type": "string",
            "description": "한 번만 제공되는 기기 credential"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "careConnectionId": {
            "type": "string",
            "format": "uuid"
          },
          "shareLevel": {
            "type": "string",
            "enum": [
              "MINIMAL",
              "BASIC"
            ]
          },
          "autoGuardianAlertThreshold": {
            "type": "string",
            "enum": [
              "NONE",
              "HIGH",
              "CRITICAL"
            ]
          }
        },
        "required": [
          "deviceId",
          "deviceCredential",
          "subjectId",
          "careConnectionId",
          "shareLevel",
          "autoGuardianAlertThreshold"
        ]
      },
      "RiskEventSenderDto": {
        "type": "object",
        "properties": {
          "masked": {
            "type": "string",
            "example": "010-****-1234"
          },
          "normalized": {
            "type": "string",
            "description": "평판 조회 후 즉시 폐기되는 E.164 번호",
            "example": "+821012341234"
          }
        },
        "required": [
          "masked",
          "normalized"
        ]
      },
      "RiskEventUrlDto": {
        "type": "object",
        "properties": {
          "canonical": {
            "type": "string",
            "example": "https://example.invalid/pay?case=fixture",
            "maxLength": 2048
          },
          "normalizedDomain": {
            "type": "string",
            "example": "example.invalid"
          },
          "normalizedUrlHash": {
            "type": "string",
            "description": "canonical URL의 SHA-256 hex"
          }
        },
        "required": [
          "canonical",
          "normalizedDomain",
          "normalizedUrlHash"
        ]
      },
      "RiskEventFeaturesDto": {
        "type": "object",
        "properties": {
          "contentAvailable": {
            "type": "boolean"
          },
          "extractionComplete": {
            "type": "boolean"
          },
          "contentTruncated": {
            "type": "boolean"
          },
          "normalizedLength": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "impersonatedEntityTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
