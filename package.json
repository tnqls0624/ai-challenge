{
  "name": "dont-worry",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @dont-worry/api prisma:generate",
    "db:migrate": "pnpm --filter @dont-worry/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @dont-worry/api db:migrate:deploy",
    "db:restore:verify": "bash infra/scripts/verify-postgres-restore.sh",
    "db:validate": "pnpm --filter @dont-worry/api db:validate",
    "dev": "turbo run dev --parallel",
    "docker:build:api": "docker build --build-arg APP_TARGET=api --tag dont-worry-api:local .",
    "docker:build:web": "docker build --build-arg APP_TARGET=web --tag dont-worry-web:local .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres",
    "lint": "eslint .",
    "openapi:generate": "pnpm --filter @dont-worry/api openapi:generate",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
